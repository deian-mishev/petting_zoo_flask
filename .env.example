# Flask
FLASK_KEY=change-me-in-production
FLASK_RUN_PORT=5000

# Video rendering
AGENT_VID_WIDTH=480
AGENT_VID_HEIGHT=360
# Frame delivery is independent of game/input updates. JPEG quality retains the previous default.
STREAM_FPS=30
STREAM_JPEG_QUALITY=75
STREAM_MAX_IN_FLIGHT=3

# MongoDB — localhost since Flask runs on the host (port mapped from Docker)
MONGO_ENABLED=false
MONGO_DB_URI=mongodb://localhost:27017/rl_db

# Keycloak — localhost since Flask runs on the host (port mapped from Docker)
OAUTH2_SERVER_URL=http://localhost:8080
OAUTH2_REALM=petting-zoo
OAUTH2_CLIENT_ID=petting-zoo-client
OAUTH2_CLIENT_SECRET=dev-secret-change-in-prod
# Blank uses the app homepage. Azure: https://www.ataripettingzoo.com/
OAUTH2_POST_LOGOUT_REDIRECT_URI=

# ML model (optional — leave blank to skip loading)
ATTARI_PRO_MODEL=
ATTARI_PRO_WEIGHTS_PATH=

# Optional TensorBoard metrics for autonomous /train sessions.
TENSORBOARD_ENABLED=false
TENSORBOARD_LOG_DIR=logs/tensorboard

# Checkpoints: local disks on Linux/WSL only; Azure requires azure_blob after offline migration.
MODEL_CHECKPOINT_BACKEND=local
MODEL_CHECKPOINT_BLOB_ACCOUNT_URL=
MODEL_CHECKPOINT_BLOB_CONTAINER=
# Set for a user-assigned managed identity; leave blank for system-assigned.
MODEL_CHECKPOINT_MANAGED_IDENTITY_CLIENT_ID=
